NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-aura-password
# Optional cutover guard. Unset or "enabled" permits writes; "maintenance" blocks them.
NEO4J_WRITE_MODE=enabled
ADMIN_PASSWORD=
CONTACT_EMAIL=
DISCOVERY_TIMEOUT_MS=14000
DISCOVERY_SEMANTIC_STAGE_MS=8000
# Set in Vercel Production before the launch deployment. Use a future UTC date
# that cannot begin before the deployment has been verified.
# NEXT_PUBLIC_DAILY_LAUNCH_DATE=YYYY-MM-DD
