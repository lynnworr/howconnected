{
  "name": "connections-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:extension": "node --test tests/extension.test.mjs",
    "icons:extension": "node scripts/generate-extension-icons.mjs",
    "package:extension": "node scripts/build-extension-release.mjs",
    "benchmark:discovery": "node scripts/benchmark-discovery.mjs",
    "benchmark:phase2a": "node scripts/benchmark-discovery.mjs --phase2a",
    "benchmark:stabilization": "node scripts/benchmark-discovery.mjs --stabilization",
    "benchmark:phase2b": "node scripts/benchmark-discovery.mjs --phase2b",
    "benchmark:domains": "node scripts/benchmark-domains.mjs",
    "benchmark:real-world": "node scripts/benchmark-real-world.mjs",
    "benchmark:gaps": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/benchmark-gaps.mjs"
    ,"validate:neo4j-free": "node --env-file-if-exists=.env.neo4j-free.local scripts/validate-neo4j-migration.mjs --target=free --use-default-database"
    ,"validate:neo4j-current": "node --env-file-if-exists=.env.local scripts/validate-neo4j-migration.mjs --target=current --read-only"
    ,"compare:neo4j-cutover": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.neo4j-free.local scripts/compare-neo4j-migration.mjs"
    ,"daily:validate": "node scripts/manage-daily-puzzles.mjs validate"
    ,"daily:duplicates": "node scripts/manage-daily-puzzles.mjs duplicates"
    ,"daily:report": "node scripts/manage-daily-puzzles.mjs report"
    ,"daily:schedule-review": "node scripts/validate-daily-schedule.mjs"
    ,"daily:schedule-promote": "node scripts/promote-daily-schedule.mjs"
    ,"daily:links": "node scripts/verify-daily-links.mjs"
    ,"daily:discover": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/manage-daily-puzzles.mjs discover"
    ,"daily:export-review": "node scripts/manage-daily-puzzles.mjs export-review"
    ,"growth:report": "node scripts/analyze-growth-events.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "neo4j-driver": "^6.2.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
